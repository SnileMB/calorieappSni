# Supabase client env vars (Vite requires the VITE_ prefix to expose these
# to the browser bundle). Get both values from:
# Supabase Dashboard -> Project Settings -> API
#
# Copy this file to .env (gitignored) and fill in real values. .env is
# created by plan 01-02, not this plan; do not commit real key values here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
